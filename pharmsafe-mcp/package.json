  "description": "Medication Safety & Pharmacogenomics Intelligence MCP — checks drug interactions, pharmacogenomic conflicts, polypharmacy risks, renal/hepatic dosing, and deprescribing opportunities",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server-http.js",
    "dev": "tsx src/server-http.ts",
